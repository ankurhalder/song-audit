# Where reports and uploads are written (default: ./data)
SONGAUDIT_DATA_DIR=./data

# Upload ceiling in megabytes
SONGAUDIT_MAX_UPLOAD_MB=100

# Whisper checkpoint used by "songaudit audit --lyrics" (tiny/base/small/medium)
SONGAUDIT_WHISPER_MODEL=base

# Hours before old jobs can be pruned (reserved for the scheduler)
SONGAUDIT_JOB_TTL_HOURS=24
